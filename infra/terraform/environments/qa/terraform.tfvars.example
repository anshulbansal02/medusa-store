aws_region  = "ap-southeast-1"
aws_profile = "your-aws-profile"

lightsail_availability_zone       = "ap-southeast-1a"
lightsail_blueprint_id            = "ubuntu_22_04"
lightsail_bundle_id               = "small_3_0"
lightsail_ssh_public_key_path     = "~/.ssh/id_ed25519_ecom_lightsail.pub"
lightsail_temporary_ssh_cidrs     = []
lightsail_automatic_snapshot_time = "20:00"

upstash_email                = "you@example.com"
upstash_redis_primary_region = "ap-southeast-1"
upstash_redis_read_regions   = []
upstash_redis_budget         = 20

# Export secret values with TF_VAR_* instead of committing them:
# export TF_VAR_neon_api_key="..."
neon_org_id                    = "your-neon-org-id"
neon_region_id                 = "aws-ap-southeast-1"
neon_pg_version                = 17
neon_history_retention_seconds = 21600

qa_storefront_domain    = "qa.example.com"
qa_medusa_api_domain    = "qa-api.example.com"
qa_medusa_admin_domain = "qa-admin.example.com"
qa_media_domain        = "qa-media.example.com"
qa_media_bucket_name   = "your-qa-media-bucket"
cloudflare_r2_account_id = "cloudflare-account-id"

# Export this optional secret with TF_VAR_* when QA email is enabled:
# export TF_VAR_resend_api_key="..."
resend_from_email             = "Store Admin <admin@mail.neonfold.com>"
admin_invite_from_email       = "Store Admin <admin@mail.neonfold.com>"
order_from_email              = "Store Team <orders@mail.neonfold.com>"
owner_order_from_email        = "Store Admin <admin@mail.neonfold.com>"
transactional_reply_to_email  = "support@mail.neonfold.com"
